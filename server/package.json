{
  "name": "@invoicetrackr/server",
  "version": "1.0.0",
  "description": "The backend for rekodev's InvoiceTrackr app",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "dev": "tsx watch --include ../shared/types/dist/**/* --include '../shared/emails/dist/**/*.js' --include '../shared/pdf/dist/**/*' src/app.ts",
    "tsc": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "migrate:prod": "node node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.config.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "author": "rekodev",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/error": "^4.2.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@invoicetrackr/emails": "workspace:*",
    "@invoicetrackr/pdf": "workspace:*",
    "@invoicetrackr/types": "workspace:*",
    "@neondatabase/serverless": "^1.2.0",
    "ajv-errors": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "exceljs": "4.4.0",
    "fastify": "^5.12.5",
    "fastify-i18n": "^3.0.0",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^6.1.0",
    "fflate": "^0.8.3",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "posthog-node": "^5.55.2",
    "resend": "^6.32.1",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "fishery": "^2.4.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0"
  }
}
