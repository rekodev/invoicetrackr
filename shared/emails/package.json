{
  "name": "@invoicetrackr/emails",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "content": [
        "dist/emails/invoice-email-content.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./content": {
      "types": "./dist/emails/invoice-email-content.d.ts",
      "default": "./dist/emails/invoice-email-content.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "email dev --dir emails",
    "dev:watch": "tsc --watch"
  },
  "dependencies": {
    "@invoicetrackr/types": "workspace:*",
    "@react-email/render": "2.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "^6.11.1"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^6.0.3"
  }
}
