{
  "name": "invoicetrackr",
  "version": "1.0.0",
  "type": "module",
  "description": "InvoiceTrackr App",
  "main": "index.js",
  "scripts": {
    "client": "pnpm --filter @invoicetrackr/client",
    "server": "pnpm --filter @invoicetrackr/server",
    "types": "pnpm --filter @invoicetrackr/types",
    "emails": "pnpm --filter @invoicetrackr/emails",
    "dev": "pnpm run types build && pnpm run emails build && pnpm run pdf build && concurrently \"pnpm run types dev\" \"pnpm run emails dev:watch\" \"pnpm run pdf dev:watch\" \"pnpm run server dev\" \"pnpm run client dev:turbo\"",
    "build": "pnpm run types build && pnpm run emails build && pnpm run pdf build && pnpm run server build && pnpm run client build",
    "lint": "pnpm run client lint && pnpm run server lint",
    "lint:fix": "pnpm run client lint:fix && pnpm run server lint:fix",
    "typecheck": "pnpm run types build && pnpm run emails build && pnpm run pdf build && pnpm run server tsc && pnpm run client tsc",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "e2e:infra:up": "docker compose --project-name invoicetrackr-e2e --file e2e/docker-compose.yml up --detach --wait",
    "e2e:infra:down": "docker compose --project-name invoicetrackr-e2e --file e2e/docker-compose.yml down --volumes",
    "e2e:db:prepare": "node e2e/scripts/prepare-database.mjs",
    "test:e2e": "node e2e/scripts/run-local.mjs",
    "test:e2e:headed": "node e2e/scripts/run-local.mjs --headed",
    "test:e2e:ui": "node e2e/scripts/run-local.mjs --ui",
    "test:e2e:ci": "playwright test",
    "pdf": "pnpm --filter @invoicetrackr/pdf"
  },
  "keywords": [],
  "author": "rekodev",
  "license": "UNLICENSED",
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "arrowParens": "always",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "next-auth": "5.0.0-beta.30",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.13.14",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.23.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
